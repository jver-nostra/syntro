<script is:inline>
  (function () {
    var ev = document.getElementById('cs-event');
    if (!ev) return;
    var src = document.getElementById('cs-src');
    var ctx = document.getElementById('cs-ctx');
    var box = document.getElementById('cs-decision');
    var lab = document.getElementById('cs-dlabel');
    var txt = document.getElementById('cs-dtext');
    var styles = {
      auto:  { label: 'ACTÚA SOLA · PACTADO', color: '#4ade80', border: 'rgba(74,222,128,0.4)',  bg: 'rgba(74,222,128,0.07)' },
      ask:   { label: 'PIDE APROBACIÓN',      color: '#fbbf24', border: 'rgba(251,191,36,0.45)', bg: 'rgba(251,191,36,0.07)' },
      skip:  { label: 'NO ACTÚA · CONTEXTO',  color: '#93c5fd', border: 'rgba(147,197,253,0.4)', bg: 'rgba(147,197,253,0.07)' }
    };
    var items = [
      { src: 'Wazuh', ev: '1.247 intentos de acceso SSH fallidos desde 91.103.0.5 en 10 minutos', ctx: 'Nadie accede por SSH desde fuera de la VPN. IP sin relación con la empresa.', d: 'auto', t: 'Bloqueada 24 h en el firewall. Incidente abierto y aviso al responsable.' },
      { src: 'Firewall', ev: 'Tráfico saliente inusual del servidor del ERP hacia una IP externa', ctx: 'La IP pertenece al proveedor que sincroniza el ERP cada noche.', d: 'ask', t: '¿Bloquear al proveedor? Podría cortar la sincronización. Esperando a Marta (IT).' },
      { src: 'WAF', ev: 'Pico de tráfico ×8 en la tienda online', ctx: 'Hoy a las 10:00 empezó la campaña de rebajas anunciada por marketing.', d: 'skip', t: 'Tráfico legítimo esperado. Se vigila, sin bloquear.' },
      { src: 'Microsoft 365', ev: 'Inicio de sesión de admin@empresa.es desde otro país', ctx: 'El administrador no tiene viajes previstos. Otro país, otro navegador.', d: 'ask', t: '¿Cerrar sesión y forzar cambio de contraseña? Avisado por Teams.' },
      { src: 'Correo', ev: 'Factura adjunta con macro desde un dominio que imita a un proveedor', ctx: 'El proveedor real envía facturas en PDF, nunca en Excel con macros.', d: 'auto', t: 'Correo en cuarentena en los 14 buzones que lo recibieron.' }
    ];
    var i = 0;
    function show() {
      var it = items[i], s = styles[it.d];
      src.textContent = it.src;
      ev.textContent = it.ev;
      ctx.textContent = it.ctx;
      lab.textContent = s.label; lab.style.color = s.color;
      box.style.borderColor = s.border; box.style.background = s.bg;
      txt.textContent = it.t;
      i = (i + 1) % items.length;
    }
    show();
    setInterval(show, 5200);
  })();
</script>

